{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Your_Database_Connection_String_Here"
  },
  "CloudinarySettings": {
    "CloudName": "Your_Cloud_Name_Here",
    "ApiKey": "Your_Api_Key_Here",
    "ApiSecret": "Your_Api_Secret_Here"
  },
  "AppSettings": {
    "Token": "Your_Secret_Token"
  }
}
